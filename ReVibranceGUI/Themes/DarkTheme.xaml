<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextForeground" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="SectionBackground" Color="#252525"/>
    <SolidColorBrush x:Key="SecondaryTextForeground" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="ListBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#333333"/>
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#444444"/>
    <SolidColorBrush x:Key="SecondaryButtonForeground" Color="White"/>
</ResourceDictionary>
