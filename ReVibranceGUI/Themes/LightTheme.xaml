<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextForeground" Color="#111111"/>
    <SolidColorBrush x:Key="SectionBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextForeground" Color="#666666"/>
    <SolidColorBrush x:Key="ListBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="SecondaryButtonHover" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="SecondaryButtonForeground" Color="Black"/>
</ResourceDictionary>
