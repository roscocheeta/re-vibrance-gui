<Window x:Class="ReVibranceGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVibranceGUI" Height="700" Width="520"
        Icon="app_icon.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI, Arial"
        FontSize="13">
    
    <Window.Resources>
        <!-- Style for the main Action Button -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4B4B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E04343"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for secondary buttons like "+ Add Game" -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for ListBox Item (Card) -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style for Segmented Theme Buttons -->
        <Style x:Key="SegmentedButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextForeground}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Theme -->
            <RowDefinition Height="Auto"/> <!-- Settings Group -->
            <RowDefinition Height="*"/>    <!-- Process List -->
            <RowDefinition Height="Auto"/> <!-- Checkboxes -->
            <RowDefinition Height="Auto"/> <!-- Start Button -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app_icon.ico" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="ReVibranceGUI" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="{DynamicResource SectionBackground}">
                <Border CornerRadius="6" Background="{DynamicResource SectionBackground}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeAutoBtn" Content="Auto" IsChecked="True" Style="{StaticResource SegmentedButton}" Checked="ThemeRadioButton_Checked"/>
                        <RadioButton x:Name="ThemeLightBtn" Content="Light" Style="{StaticResource SegmentedButton}" Checked="ThemeRadioButton_Checked"/>
                        <RadioButton x:Name="ThemeDarkBtn" Content="Dark" Style="{StaticResource SegmentedButton}" Checked="ThemeRadioButton_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Settings Group -->
        <Border Grid.Row="1" Background="{DynamicResource SectionBackground}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Global Settings" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextForeground}" Margin="0,0,0,15"/>
                
                <TextBlock Text="Default Windows Vibrance:" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="WindowsVibranceSlider" Minimum="50" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock x:Name="WindowsVibranceValue" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="50%"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Monitored Games -->
        <Border Grid.Row="2" Background="{DynamicResource SectionBackground}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Monitored Games" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextForeground}" VerticalAlignment="Center"/>
                    <Button x:Name="AddGameButton" Content="+ Add Game" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="AddGameButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Auto-Scan Installed Games..." Click="ScanGamesMenuItem_Click"/>
                                <MenuItem Header="Select from Running Processes..." Click="RunningProcessesMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="Browse for .exe..." Click="BrowseMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- List -->
                <ListBox x:Name="ProcessListBox" Grid.Row="1" ItemsSource="{Binding TargetProcesses}" 
                         Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" Margin="0,0,0,4">
                                <Border CornerRadius="8" Background="{DynamicResource WindowBackground}" BorderThickness="1" BorderBrush="{DynamicResource SecondaryButtonBackground}" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                            <ColumnDefinition Width="*"/> <!-- Info and Slider -->
                                            <ColumnDefinition Width="Auto"/> <!-- Remove Btn -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon -->
                                        <Image Grid.Column="0" Source="{Binding IconImage}" Width="40" Height="40" Margin="0,0,12,0"/>
                                        
                                        <!-- Center Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="50" Maximum="100" Value="{Binding VibranceLevel, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0" ValueChanged="GameSlider_ValueChanged"/>
                                                <TextBlock Grid.Column="1" Text="{Binding VibranceLevel, StringFormat={}{0}%}" Foreground="{DynamicResource SecondaryTextForeground}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        
                                        <!-- Remove -->
                                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand" Click="RemoveProcess_Click" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Application Behavior -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <CheckBox x:Name="RunOnStartupCheckBox" Content="Run on Startup" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" Checked="RunOnStartupCheckBox_Checked" Unchecked="RunOnStartupCheckBox_Unchecked"/>
            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to system tray when monitoring" Foreground="{DynamicResource TextForeground}"/>
        </StackPanel>

        <!-- Action Area -->
        <Button Grid.Row="4" x:Name="ToggleAutomationButton" Content="START MONITORING" Style="{StaticResource AccentButton}" Height="45" FontSize="16" Margin="0,0,0,15" Click="ToggleAutomationButton_Click"/>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="-15,0,-15,-15">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SecondaryButtonBackground}" Background="{DynamicResource SectionBackground}" Padding="15,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Path x:Name="HardwareIcon" Data="M10,2H14V4H16V6H18V8H20V10H18V14H20V16H18V18H16V20H14V22H10V20H8V18H6V16H4V14H6V10H4V8H6V6H8V4H10V2M14,6H10V18H14V6Z" Fill="{DynamicResource SecondaryTextForeground}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HardwareText" Grid.Column="1" Text="Searching for GPU..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="MonitoringDot" Width="8" Height="8" Fill="#999999" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MonitoringText" Text="Idle" FontSize="12" Foreground="{DynamicResource SecondaryTextForeground}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
