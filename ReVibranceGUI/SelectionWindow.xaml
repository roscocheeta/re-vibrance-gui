<Window x:Class="ReVibranceGUI.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Target" Height="400" MinWidth="400" MaxWidth="700" SizeToContent="Width"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderTextBlock" Text="Select an option:" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <ListBox x:Name="ItemListBox" Grid.Row="1" Background="{DynamicResource ListBackground}" Foreground="{DynamicResource TextForeground}" BorderThickness="0" MouseDoubleClick="ItemListBox_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Padding="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="70" Height="30" Click="Cancel_Click" Margin="0,0,10,0" Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonForeground}" BorderThickness="0"/>
            <Button Content="Select" Width="70" Height="30" Click="Select_Click" Background="#FF4B4B" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
