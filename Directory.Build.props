<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Version is overridden by CI from the git tag (vX.Y.Z -> X.Y.Z). -->
    <Version>0.1.0</Version>
    <Authors>roscocheeta</Authors>
    <Product>ReVibranceGUI</Product>

    <!-- Lock files make restores reproducible and enable NuGet caching in CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

    <!-- Warnings in our own code fail the build. Vendor code is exempted via .editorconfig. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
