root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,xml,csproj,props}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_sort_system_directives_first = true

# Third-party AMD ADL interop copied from upstream vibranceGUI.
# Treated as generated code so nullable/style warnings don't fail our build.
[ReVibranceGUI/AMD/vendor/**.cs]
generated_code = true
